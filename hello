<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>20/10 - Chúc các bạn nữ</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  body {
    background: #000;
    font-family: 'Segoe UI', system-ui, sans-serif;
    overflow: hidden;
    height: 100vh;
    width: 100vw;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
  }

  #app {
    width: 100%;
    max-width: 420px;
    height: 100vh;
    max-height: 900px;
    position: relative;
    overflow: hidden;
    background: #0a0a1a;
  }

  /* ===== CHUYỂN CẢNH MƯỢT ===== */
  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transform: scale(0.94) translateY(30px);
    transition: 
      opacity 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .scene.active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1) translateY(0);
  }

  .scene.leaving {
    opacity: 0;
    transform: scale(1.05) translateY(-25px);
    pointer-events: none;
  }

  /* ===== SCENE 1: Hoa hồng ===== */
  #scene1 {
    background: radial-gradient(ellipse at center, #1a0a2e 0%, #050510 100%);
  }

  .dome-container {
    position: relative;
    width: 220px;
    height: 280px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .glass-dome {
    position: absolute;
    width: 200px;
    height: 240px;
    border: 3px solid rgba(255,255,255,0.25);
    border-radius: 100px 100px 20px 20px;
    background: linear-gradient(180deg, rgba(255,255,255,0.08) 0%, transparent 60%);
    box-shadow: 
      inset 0 0 30px rgba(255,180,255,0.15),
      0 0 40px rgba(255,100,200,0.2);
    z-index: 2;
  }

  .base {
    position: absolute;
    bottom: 0;
    width: 160px;
    height: 18px;
    background: linear-gradient(90deg, #4a2a1a, #8b5a2b, #4a2a1a);
    border-radius: 8px;
    z-index: 1;
  }

  .rose {
    position: absolute;
    bottom: 40px;
    width: 80px;
    height: 120px;
    z-index: 3;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .rose:active {
    transform: scale(0.9);
  }

  .rose-petals {
    position: relative;
    width: 60px;
    height: 60px;
    margin: 0 auto;
  }

  .petal {
    position: absolute;
    width: 28px;
    height: 40px;
    background: linear-gradient(135deg, #ff6b9d, #c44569);
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    box-shadow: 0 0 15px rgba(255,100,150,0.6);
  }

  .petal:nth-child(1) { transform: rotate(0deg) translateY(-8px); }
  .petal:nth-child(2) { transform: rotate(60deg) translateY(-8px); }
  .petal:nth-child(3) { transform: rotate(120deg) translateY(-8px); }
  .petal:nth-child(4) { transform: rotate(180deg) translateY(-8px); }
  .petal:nth-child(5) { transform: rotate(240deg) translateY(-8px); }
  .petal:nth-child(6) { transform: rotate(300deg) translateY(-8px); }

  .rose-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 18px;
    height: 18px;
    background: #ffd700;
    border-radius: 50%;
    box-shadow: 0 0 12px #ffd700;
  }

  .stem {
    width: 6px;
    height: 70px;
    background: linear-gradient(to bottom, #2d8a4e, #1a5c33);
    margin: 0 auto;
    border-radius: 3px;
    position: relative;
  }

  .leaf {
    position: absolute;
    width: 20px;
    height: 12px;
    background: #2d8a4e;
    border-radius: 0 100% 0 100%;
  }

  .leaf.left { left: -16px; top: 25px; transform: rotate(-30deg); }
  .leaf.right { right: -16px; top: 40px; transform: rotate(30deg) scaleX(-1); }

  .sparkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .sparkle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: white;
    border-radius: 50%;
    box-shadow: 0 0 8px #ff9;
    animation: twinkle 1.8s infinite ease-in-out;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.15; transform: scale(0.5); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .instruction {
    margin-top: 40px;
    font-size: 16px;
    color: #ffb6d9;
    text-align: center;
    animation: pulse 2.2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  .hold-btn {
    margin-top: 20px;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    border: 3px solid #ff6b9d;
    background: rgba(255,107,157,0.15);
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hold-btn:active {
    transform: scale(0.9);
  }

  .hold-btn::after {
    content: '';
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #ff6b9d;
    box-shadow: 0 0 20px #ff6b9d;
  }

  /* ===== SCENE 2,3,4: NỀN TRỜI ĐÊM ===== */
  #scene2, #scene3, #scene4 {
    background: linear-gradient(180deg, #0d0d2b 0%, #12123a 60%, #0a1f14 100%);
  }

  .sky-stars {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .star {
    position: absolute;
    width: 2px;
    height: 2px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 4px #fff;
    animation: floatStar 5s infinite ease-in-out;
  }

  @keyframes floatStar {
    0%, 100% { transform: translateY(0) scale(1); opacity: 0.4; }
    50% { transform: translateY(-14px) scale(1.5); opacity: 1; }
  }

  .grass {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: linear-gradient(to top, #0a1f14, transparent);
    pointer-events: none;
  }

  /* ===== CHỮ PHÁT SÁNG ===== */
  .wish-text {
    font-size: 26px;
    font-weight: 600;
    color: #ff9ecb;
    text-align: center;
    line-height: 1.5;
    padding: 0 24px;
    letter-spacing: 0.5px;
    text-shadow: 
      0 0 8px rgba(255, 158, 203, 0.9),
      0 0 20px rgba(255, 120, 180, 0.7),
      0 0 40px rgba(255, 80, 160, 0.45);
    opacity: 0;
    transform: translateY(40px) scale(0.92);
    transition: all 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wish-text.show {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .wish-text.hide {
    opacity: 0;
    transform: translateY(-30px) scale(1.06);
  }

  /* ===== SCENE 3: Bó hoa ===== */
  .bouquet {
    width: 220px;
    height: 260px;
    position: relative;
    animation: bloom 1.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes bloom {
    from { transform: scale(0.15) rotate(-12deg); opacity: 0; }
    to { transform: scale(1) rotate(0deg); opacity: 1; }
  }

  .bouquet-flower {
    position: absolute;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, #ff8fab, #e91e8c);
    box-shadow: 0 0 15px rgba(233,30,140,0.5);
  }

  .bouquet-wrap {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 140px;
    height: 100px;
    background: linear-gradient(135deg, #ffe0ec, #ffc1d9);
    border-radius: 20px 20px 40px 40px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }

  .ribbon {
    position: absolute;
    bottom: 70px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 16px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }

  /* ===== SCENE 4: Thư ===== */
  .envelope {
    width: 260px;
    height: 180px;
    position: relative;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .envelope:active {
    transform: scale(0.96);
  }

  .envelope.open .flap {
    transform: rotateX(180deg);
  }

  .envelope-body {
    width: 100%;
    height: 100%;
    background: #f8f0e8;
    border-radius: 8px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.35);
    position: relative;
    overflow: hidden;
  }

  .flap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 90px;
    background: #f0e6d8;
    clip-path: polygon(0 0, 50% 100%, 100% 0);
    transform-origin: top;
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 2;
  }

  .letter {
    position: absolute;
    bottom: 10px;
    left: 15px;
    right: 15px;
    background: white;
    padding: 16px;
    border-radius: 6px;
    font-size: 13px;
    color: #333;
    line-height: 1.55;
    max-height: 140px;
    overflow-y: auto;
    transform: translateY(30px);
    opacity: 0;
    transition: all 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.3s;
  }

  .envelope.open .letter {
    transform: translateY(0);
    opacity: 1;
  }

  .letter p {
    margin-bottom: 8px;
  }

  .letter .signature {
    text-align: right;
    font-style: italic;
    margin-top: 12px;
    color: #e91e8c;
  }

  /* ===== SCENE 5: Màn cuối ===== */
  #scene5 {
    background: radial-gradient(ellipse at center, #0d0d2b 0%, #050510 100%);
    overflow: hidden;
  }

  .floating-hearts {
    position: absolute;
    inset: 0;
  }

  .heart {
    position: absolute;
    font-size: 20px;
    color: #ff4d6d;
    animation: floatHeart linear infinite;
    opacity: 0.85;
    text-shadow: 0 0 12px #ff4d6d;
  }

  @keyframes floatHeart {
    0% { transform: translateY(100vh) rotate(0deg) scale(0.5); opacity: 0; }
    12% { opacity: 0.9; }
    88% { opacity: 0.9; }
    100% { transform: translateY(-120px) rotate(360deg) scale(1.25); opacity: 0; }
  }

  .floating-text {
    position: absolute;
    font-size: 14px;
    font-weight: 600;
    color: #ff9ecb;
    white-space: nowrap;
    text-shadow: 
      0 0 8px rgba(255, 158, 203, 0.85),
      0 0 18px rgba(255, 100, 180, 0.5);
    animation: floatText linear infinite;
  }

  @keyframes floatText {
    0% { transform: translateY(100vh) translateX(0); opacity: 0; }
    15% { opacity: 1; }
    85% { opacity: 1; }
    100% { transform: translateY(-60px) translateX(25px); opacity: 0; }
  }

  .final-text {
    position: relative;
    z-index: 10;
    text-align: center;
    font-size: 24px;
    font-weight: 600;
    color: #ff9ecb;
    text-shadow: 
      0 0 12px rgba(255, 158, 203, 0.95),
      0 0 28px rgba(255, 100, 180, 0.7),
      0 0 50px rgba(255, 60, 140, 0.4);
    padding: 0 20px;
    animation: finalAppear 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes finalAppear {
    from { opacity: 0; transform: scale(0.8) translateY(40px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* Nút tiếp tục */
  .next-btn {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, #ff6b9d, #e91e8c);
    color: white;
    border: none;
    padding: 13px 34px;
    border-radius: 30px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(233,30,140,0.45);
    z-index: 20;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    opacity: 0;
    animation: btnAppear 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes btnAppear {
    from { opacity: 0; transform: translateX(-50%) translateY(25px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  .next-btn:active {
    transform: translateX(-50%) scale(0.93);
  }

  .hidden {
    display: none !important;
  }
</style>
</head>
<body>
<div id="app">

  <!-- SCENE 1 -->
  <div class="scene active" id="scene1">
    <div class="dome-container">
      <div class="glass-dome"></div>
      <div class="base"></div>
      <div class="rose" id="rose">
        <div class="rose-petals">
          <div class="petal"></div>
          <div class="petal"></div>
          <div class="petal"></div>
          <div class="petal"></div>
          <div class="petal"></div>
          <div class="petal"></div>
          <div class="rose-center"></div>
        </div>
        <div class="stem">
          <div class="leaf left"></div>
          <div class="leaf right"></div>
        </div>
      </div>
      <div class="sparkles" id="sparkles"></div>
    </div>
    <div class="instruction" id="instruction">Nhấn giữ để bắt đầu</div>
    <div class="hold-btn" id="holdBtn"></div>
  </div>

  <!-- SCENE 2 -->
  <div class="scene" id="scene2">
    <div class="sky-stars" id="stars"></div>
    <div class="wish-text" id="wish1">Chúc các<br>bạn nữ lớp<br>mình</div>
    <div class="wish-text" id="wish2" style="display:none;">Ngày Phụ nữ<br>Việt Nam<br>20/10</div>
    <div class="wish-text" id="wish3" style="display:none;">Luôn xinh đẹp,<br>tràn ngập<br>niềm vui</div>
    <div class="wish-text" id="wish4" style="display:none;">Tự tin tỏa sáng<br>theo cách riêng<br>của mình</div>
    <div class="grass"></div>
    <button class="next-btn hidden" id="btn2">Tiếp tục</button>
  </div>

  <!-- SCENE 3 -->
  <div class="scene" id="scene3">
    <div class="sky-stars" id="stars3"></div>
    <div class="bouquet" id="bouquet">
      <div class="bouquet-wrap"></div>
      <div class="ribbon"></div>
    </div>
    <div class="grass"></div>
    <button class="next-btn" id="btn3">Tiếp tục</button>
  </div>

  <!-- SCENE 4 -->
  <div class="scene" id="scene4">
    <div class="sky-stars" id="stars4"></div>
    <div class="envelope" id="envelope">
      <div class="envelope-body">
        <div class="flap"></div>
        <div class="letter">
          <p><strong>Gửi các bạn nữ của lớp mình!</strong></p>
          <p>Nhân ngày Phụ nữ Việt Nam 20/10, chúc các bạn luôn rạng rỡ, gặp nhiều điều tốt đẹp trong học tập cũng như cuộc sống.</p>
          <p>Cảm ơn các bạn đã cùng chúng mình tạo nên những ngày đi học thật vui và nhiều kỷ niệm. Mong rằng lớp mình sẽ luôn đoàn kết, giúp đỡ nhau và có thêm thật nhiều khoảnh khắc đáng nhớ.</p>
          <p>Chúc các bạn hôm nay nhận được nhiều yêu thương, còn những ngày sau vẫn luôn có thật nhiều lý do để mỉm cười!</p>
          <p class="signature">— Các bạn nam —</p>
        </div>
      </div>
    </div>
    <div class="grass"></div>
    <button class="next-btn hidden" id="btn4">Tiếp tục</button>
  </div>

  <!-- SCENE 5: Màn cuối -->
  <div class="scene" id="scene5">
    <div class="floating-hearts" id="hearts"></div>
    <div class="final-text">
      Chúc các bạn<br>luôn rạng rỡ ✨<br>
      <span style="font-size:16px;font-weight:400;opacity:0.9">Xinh tươi • Học giỏi • Cười nhiều</span>
    </div>
  </div>

</div>

<script>
  function createSparkles(container, count = 14) {
    for (let i = 0; i < count; i++) {
      const s = document.createElement('div');
      s.className = 'sparkle';
      s.style.left = Math.random() * 100 + '%';
      s.style.top = Math.random() * 100 + '%';
      s.style.animationDelay = Math.random() * 2.5 + 's';
      container.appendChild(s);
    }
  }

  function createStars(container, count = 45) {
    for (let i = 0; i < count; i++) {
      const s = document.createElement('div');
      s.className = 'star';
      s.style.left = Math.random() * 100 + '%';
      s.style.top = Math.random() * 85 + '%';
      s.style.width = (1.2 + Math.random() * 2) + 'px';
      s.style.height = s.style.width;
      s.style.animationDelay = Math.random() * 5 + 's';
      s.style.animationDuration = (4 + Math.random() * 4) + 's';
      container.appendChild(s);
    }
  }

  let currentScene = 1;
  let isTransitioning = false;

  function showScene(n) {
    if (isTransitioning || n === currentScene) return;
    isTransitioning = true;

    const current = document.getElementById('scene' + currentScene);
    const next = document.getElementById('scene' + n);

    current.classList.add('leaving');
    current.classList.remove('active');

    setTimeout(() => {
      next.classList.add('active');
      setTimeout(() => {
        current.classList.remove('leaving');
        isTransitioning = false;
      }, 1100);
    }, 250);

    currentScene = n;

    if (n === 2) startWishSequence();
    if (n === 3) createBouquet();
    if (n === 5) startFloating();
  }

  // Scene 1
  const holdBtn = document.getElementById('holdBtn');
  const instruction = document.getElementById('instruction');
  let holdTimer = null;
  let holding = false;

  createSparkles(document.getElementById('sparkles'));

  function startHold() {
    holding = true;
    holdTimer = setTimeout(() => {
      instruction.textContent = 'Chạm nhẹ bông hoa';
      holdBtn.classList.add('hidden');
      document.getElementById('rose').addEventListener('click', () => {
        showScene(2);
      }, { once: true });
    }, 1000);
  }

  function endHold() {
    if (holding) {
      clearTimeout(holdTimer);
      holding = false;
    }
  }

  holdBtn.addEventListener('mousedown', startHold);
  holdBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startHold(); });
  holdBtn.addEventListener('mouseup', endHold);
  holdBtn.addEventListener('touchend', endHold);
  holdBtn.addEventListener('mouseleave', endHold);

  // Scene 2
  function startWishSequence() {
    createStars(document.getElementById('stars'));
    const wishes = ['wish1', 'wish2', 'wish3', 'wish4'];
    let i = 0;

    function nextWish() {
      if (i > 0) {
        const prev = document.getElementById(wishes[i-1]);
        prev.classList.remove('show');
        prev.classList.add('hide');
        setTimeout(() => {
          prev.style.display = 'none';
          prev.classList.remove('hide');
        }, 800);
      }
      if (i < wishes.length) {
        const el = document.getElementById(wishes[i]);
        el.style.display = 'block';
        setTimeout(() => el.classList.add('show'), 100);
        i++;
        setTimeout(nextWish, 2800);
      } else {
        document.getElementById('btn2').classList.remove('hidden');
      }
    }
    nextWish();
  }

  document.getElementById('btn2').addEventListener('click', () => showScene(3));

  // Scene 3
  function createBouquet() {
    createStars(document.getElementById('stars3'));
    const bouquet = document.getElementById('bouquet');
    bouquet.querySelectorAll('.bouquet-flower').forEach(f => f.remove());

    const positions = [
      { left: 40, top: 20 }, { left: 90, top: 10 }, { left: 140, top: 25 },
      { left: 55, top: 55 }, { left: 110, top: 45 }, { left: 160, top: 60 },
      { left: 70, top: 90 }, { left: 125, top: 80 }
    ];
    positions.forEach((p, i) => {
      const f = document.createElement('div');
      f.className = 'bouquet-flower';
      f.style.left = p.left + 'px';
      f.style.top = p.top + 'px';
      f.style.animationDelay = (i * 0.1) + 's';
      bouquet.insertBefore(f, bouquet.firstChild);
    });
  }

  document.getElementById('btn3').addEventListener('click', () => showScene(4));

  // Scene 4
  createStars(document.getElementById('stars4'));
  const envelope = document.getElementById('envelope');
  envelope.addEventListener('click', () => {
    envelope.classList.add('open');
    setTimeout(() => {
      document.getElementById('btn4').classList.remove('hidden');
    }, 950);
  }, { once: true });

  document.getElementById('btn4').addEventListener('click', () => showScene(5));

  // Scene 5
  function startFloating() {
    const container = document.getElementById('hearts');
    const texts = [
      'Chúc các bạn luôn rạng rỡ',
      'Luôn xinh tươi và hạnh phúc',
      'Xinh tươi, học giỏi, cười nhiều',
      'Tự tin tỏa sáng',
      'Luôn hạnh phúc',
      'Chúc các bạn học thật giỏi'
    ];

    setInterval(() => {
      const h = document.createElement('div');
      h.className = 'heart';
      h.textContent = '❤️';
      h.style.left = Math.random() * 90 + '%';
      h.style.fontSize = (16 + Math.random() * 22) + 'px';
      h.style.animationDuration = (7 + Math.random() * 5) + 's';
      container.appendChild(h);
      setTimeout(() => h.remove(), 13000);
    }, 420);

    setInterval(() => {
      const t = document.createElement('div');
      t.className = 'floating-text';
      t.textContent = texts[Math.floor(Math.random() * texts.length)];
      t.style.left = Math.random() * 65 + '%';
      t.style.animationDuration = (9 + Math.random() * 4) + 's';
      container.appendChild(t);
      setTimeout(() => t.remove(), 15000);
    }, 1300);
  }
</script>
</body>
</html>
